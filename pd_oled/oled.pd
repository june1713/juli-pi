#N canvas 771 92 1000 650 12;
#X text 50 25 PURE DATA -> OSC -> OLED;
#X text 50 55 Raspberry Pi localhost:8000;
#X text 50 80 OSC messages are sent only when values change;
#X obj 50 120 loadbang;
#X msg 50 150 connect 127.0.0.1 8000;
#X msg 250 150 disconnect;
#X obj 50 190 netsend -u -b;
#X obj 50 230 tgl 25 0 empty empty CONNECTED 35 12 0 12 #fcfcfc #000000 #000000 0 1;
#X text 50 275 TEXT MESSAGE;
#X symbolatom 50 310 65 0 0 0 - - - 0;
#X obj 50 350 oscformat text;
#X obj 50 385 list prepend send;
#X obj 50 420 list trim;
#X text 50 465 SLIDER;
#X text 50 495 Slider is quantized to 0.01 steps before OSC;
#X obj 42 538 hsl 600 35 0 1 0 0 empty empty 0.00--------------------1.00 10 15 0 14 #fcfcfc #000000 #000000 0 1;
#X obj 670 535 * 100;
#X obj 670 570 int;
#X obj 670 605 / 100;
#X obj 760 605 change;
#X obj 760 535 floatatom 8 0 0 0 - - - 0;
#X obj 760 570 floatatom 8 0 0 0 - - - 0;
#X obj 850 605 oscformat slider;
#X obj 850 640 list prepend send;
#X obj 850 675 list trim;
#X text 665 510 quantized;
#X text 755 510 filtered;
#X text 845 510 OSC;
